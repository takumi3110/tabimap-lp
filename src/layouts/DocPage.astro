---
import Base from '../layouts/Base.astro'
import BrandMark from '../components/BrandMark.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { APPLE_STANDARD_EULA } from '../consts'

interface TocItem {
  href: string
  label: string
}

interface Props {
  /** ブラウザのタブとギャラリーに出る名前 */
  title: string
  description: string
  /** ページ上部の見出し。title と別にできる */
  heading: string
  lead?: string
  toc: TocItem[]
}

const { title, description, heading, lead, toc } = Astro.props

const footerLinks = [
  { href: '/', label: 'アプリの紹介' },
  { href: '/support', label: 'サポート' },
  { href: '/privacy', label: 'プライバシーポリシー' },
  { href: APPLE_STANDARD_EULA, label: '利用規約' }
]
---

<Base title={title} description={description}>
  <header class="top">
    <div class="wrap">
      <div class="top-bar">
        <a class="brand" href="/">
          <BrandMark size={30} />
          <span class="brand-name">たびまっぷ</span>
        </a>
        <a class="top-back" href="/">← アプリの紹介ページへ</a>
      </div>

      <h1>{heading}</h1>
      {lead && <p>{lead}</p>}
    </div>
  </header>

  <div class="wrap">
    <div class="layout">
      <nav class="toc" aria-label="このページの目次">
        <p class="toc-label">目次</p>
        {toc.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <main class="doc">
        <slot />
      </main>
    </div>
  </div>

  <SiteFooter links={footerLinks} />
</Base>

<style is:global>
  /* 読み物なので本文は少し大きめ・行間広め */
  body { font-size: 15.5px; line-height: 1.95; }
  .doc h2, .doc h3, .top h1 { line-height: 1.45; }
  a { color: var(--teal); }
  a:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; border-radius: 3px; }
  p, ul, ol { margin: 0; }
  .wrap { --wrap: 1040px; }

  /* ---------- ヘッダー ---------- */
  .top { background: var(--teal-deep); color: #fff; padding-block: 22px 30px; }
  .top-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; }
  .brand-name { font-family: var(--f-display); font-weight: 700; font-size: 16px; letter-spacing: .04em; }
  .top-back { font-size: 13px; color: rgba(255,255,255,.72); text-decoration: none; }
  .top-back:hover { color: #fff; text-decoration: underline; }
  .top h1 { font-size: clamp(24px, 3.4vw, 32px); font-weight: 700; margin-top: 26px; }
  .top p { color: rgba(255,255,255,.76); font-size: 14.5px; margin-top: 8px; max-width: 44em; }

  /* ---------- 本文レイアウト ---------- */
  .layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    padding-block: clamp(36px, 5vw, 60px) 72px;
    align-items: start;
  }
  @media (max-width: 820px) { .layout { grid-template-columns: minmax(0, 1fr); } }

  /* 目次 */
  .toc { position: sticky; top: 24px; display: grid; gap: 8px; }
  @media (max-width: 820px) {
    .toc { position: static; background: var(--card); border-radius: 14px; padding: 18px 20px; }
  }
  .toc-label {
    font-family: var(--f-mono); font-size: 11px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px;
  }
  .toc a {
    display: block; font-size: 13.5px; line-height: 1.7; text-decoration: none;
    color: var(--ink-2); padding: 3px 0 3px 12px; border-left: 2px solid var(--line);
  }
  .toc a:hover { color: var(--teal); border-left-color: var(--teal); }

  /* 本文 */
  .doc { display: grid; gap: clamp(40px, 5vw, 56px); max-width: 68ch; min-width: 0; }
  .doc section { display: grid; gap: 16px; scroll-margin-top: 24px; }
  .doc h2 {
    font-size: clamp(19px, 2.4vw, 23px); font-weight: 700;
    padding-bottom: 12px; border-bottom: 1px solid var(--line);
  }
  .doc h3 { font-size: 16px; font-weight: 700; }
  .doc p { color: var(--ink-2); }
  .doc ul, .doc ol { color: var(--ink-2); padding-left: 1.35em; display: grid; gap: 6px; }
  .doc li::marker { color: var(--ink-3); }
  .doc strong { color: var(--ink); font-weight: 700; }

  /* 画面内の場所を指す表記 */
  .path {
    font-family: var(--f-mono); font-size: .88em;
    background: var(--card); color: var(--ink);
    padding: 2px 7px; border-radius: 6px;
    white-space: nowrap;
  }
  @media (max-width: 560px) { .path { white-space: normal; } }

  /* 困りごと1件 */
  .issue { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .issue + .issue { margin-top: -4px; }
  .issue summary {
    cursor: pointer; list-style: none;
    padding: 16px 44px 16px 18px;
    font-family: var(--f-display); font-weight: 700; font-size: 15.5px;
    position: relative; line-height: 1.6;
  }
  .issue summary::-webkit-details-marker { display: none; }
  .issue summary::after {
    content: "+"; position: absolute; right: 18px; top: 15px;
    font-family: var(--f-mono); color: var(--teal); font-size: 19px;
  }
  .issue[open] summary::after { content: "–"; }
  .issue[open] summary { border-bottom: 1px solid var(--line); }
  .issue summary:focus-visible { outline: 2px solid var(--orange); outline-offset: -2px; }
  .issue-body { padding: 16px 18px 20px; display: grid; gap: 12px; }
  .issues { display: grid; gap: 10px; }

  /* 環境テーブル */
  .env { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .env-row { display: grid; grid-template-columns: 168px 1fr; gap: 16px; padding: 13px 18px; font-size: 14.5px; }
  .env-row + .env-row { border-top: 1px solid var(--line); }
  .env-row dt { color: var(--ink-2); }
  .env-row dd { margin: 0; color: var(--ink); }
  @media (max-width: 520px) { .env-row { grid-template-columns: 1fr; gap: 2px; } }

  /* 注記 */
  .note {
    border-left: 3px solid var(--orange);
    background: var(--card);
    border-radius: 0 10px 10px 0;
    padding: 12px 16px;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>

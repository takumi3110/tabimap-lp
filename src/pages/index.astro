---
import Base from '../layouts/Base.astro'
import BrandMark from '../components/BrandMark.astro'
import SiteFooter from '../components/SiteFooter.astro'

const footerLinks = [
  { href: '#pricing', label: '料金' },
  { href: '#features', label: '機能' },
  { href: '/support', label: 'サポート' },
  { href: '#', label: 'プライバシーポリシー' },
  { href: '#', label: '利用規約' }
]
---

<Base
  title="たびまっぷ"
  description="行きたい場所を集めて、そのまま旅の予定に。iPhone の旅程アプリ「たびまっぷ」。"
>
  <!-- ============ ヒーロー ============ -->
  <header class="hero">
    <svg class="contours" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#ffffff" stroke-width="1.2">
        <path d="M-40 500 C 180 430, 300 520, 480 450 S 820 350, 1240 420"/>
        <path d="M-40 545 C 190 480, 320 560, 500 495 S 830 400, 1240 465"/>
        <path d="M-40 455 C 170 380, 290 480, 460 405 S 810 300, 1240 375"/>
        <path d="M-40 120 C 200 60, 340 170, 520 100 S 860 20, 1240 90"/>
        <path d="M-40 168 C 210 108, 350 218, 530 148 S 870 68, 1240 138"/>
      </g>
    </svg>

    <div class="wrap">
      <div class="brand">
        <BrandMark size={38} />
        <span class="brand-name">たびまっぷ</span>
      </div>

      <div class="hero-grid">
        <div>
          <h1>行きたい場所を集めて、<br><span class="mark">そのまま旅の予定に。</span></h1>
          <p class="hero-lead">
            保存したスポットを日付に並べるだけで、旅程ができあがる iPhone アプリ。
            予定と予定のあいだに移動時間が並ぶから、詰め込みすぎに出発前に気づけます。
          </p>
          <div class="hero-cta">
            <a class="btn btn-solid" href="#download">
              App Store でダウンロード
              <span aria-hidden="true">→</span>
            </a>
            <a class="btn btn-ghost" href="#features">できることを見る</a>
          </div>
          <p class="hero-note">無料で使えます・アカウント登録は不要・iPhone 対応</p>
        </div>

        <div class="device" role="img" aria-label="トリップ詳細の画面。沖縄旅行、3泊4日・予定5件。7月30日のタイムラインに、11時から13時の「国際通りで買い物」、車で約6分の移動、14時から16時の「首里城公園」が並んでいる。">
          <div class="scr-head">
            <span class="scr-chev" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"/></svg>
            </span>
            <span class="scr-id">
              <span class="scr-title">沖縄旅行</span>
              <span class="scr-sub">3泊4日 ・ 予定5件</span>
            </span>
            <span class="scr-more" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="8" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="16" cy="12" r="1"/></svg>
            </span>
          </div>

          <div class="chips">
            <span class="chip on">7/30</span>
            <span class="chip">7/31</span>
            <span class="chip">8/1</span>
            <span class="chip">8/2</span>
          </div>

          <div class="seg">
            <span class="on">タイムライン</span>
            <span>地図</span>
          </div>

          <div class="tl">
            <div class="tl-item">
              <span class="tl-rail"><b>11:00</b><b>–13:00</b><i></i></span>
              <div class="tl-card">
                <span class="tl-top"><span class="tl-name">国際通りで買い物</span></span>
                <span class="tl-spot">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.4A2.4 2.4 0 1 1 12 6.6a2.4 2.4 0 0 1 0 4.8z"/></svg>
                  国際通り
                </span>
                <span class="tl-meta">¥8,000</span>
              </div>
            </div>

            <div class="tl-move">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M6 17v-4l1.6-4.2A2 2 0 0 1 9.5 7.5h5a2 2 0 0 1 1.9 1.3L18 13v4"/><circle cx="8" cy="17" r="1.6"/><circle cx="16" cy="17" r="1.6"/></svg>
              車 約6分
            </div>

            <div class="tl-item">
              <span class="tl-rail"><b>14:00</b><b>–16:00</b><i></i></span>
              <div class="tl-card">
                <span class="tl-top">
                  <span class="tl-name">首里城公園</span>
                  <span class="tl-bell" aria-hidden="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 8-3 8h18s-3-1-3-8z"/><path d="M10.3 21a2 2 0 0 0 3.4 0"/></svg>
                  </span>
                </span>
                <span class="tl-spot">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.4A2.4 2.4 0 1 1 12 6.6a2.4 2.4 0 0 1 0 4.8z"/></svg>
                  首里城
                </span>
                <span class="tl-meta">¥5,000 ・ 30分前に通知</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ============ 3ステップ ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head rise">
        <p class="eyebrow">How it works</p>
        <h2>集める、並べる、出かける。</h2>
        <p>旅の準備は、だいたいこの3つの順番で進みます。たびまっぷはその順番のまま作られています。</p>
      </div>

      <div class="steps">
        <div class="step rise">
          <div class="step-rail">
            <span class="step-num">STEP 1</span>
            <span class="step-dot"></span>
          </div>
          <div>
            <h3>見つけたそばから保存する</h3>
            <p>地図で施設をタップ、または気になった地点を長押しするだけ。グルメ・観光・宿泊などのカテゴリで分けておけます。SNS や他のアプリで見つけた場所は、共有シートからそのまま送れます。</p>
          </div>
        </div>

        <div class="step rise">
          <div class="step-rail">
            <span class="step-num">STEP 2</span>
            <span class="step-dot"></span>
          </div>
          <div>
            <h3>日付に並べて旅程にする</h3>
            <p>保存したスポットを日付に置いていくと、その日のタイムラインができあがります。開始時刻をずらせば終了時刻も同じ幅で動くので、時間帯の調整は数タップで済みます。トップの一覧はカレンダー表示に切り替えられるので、旅の全体像も確認できます。</p>
          </div>
        </div>

        <div class="step rise">
          <div class="step-rail">
            <span class="step-num">STEP 3</span>
            <span class="step-dot"></span>
          </div>
          <div>
            <h3>あとは出発するだけ</h3>
            <p>予定の前にリマインダーが届きます。保存済みのデータはオフラインでも読めるので、電波の心もとない場所でも今日の行き先を確認できます。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 移動時間スポットライト ============ -->
  <section class="section section-cream">
    <div class="wrap">
      <div class="spotlight rise">
        <div>
          <p class="eyebrow">The reason it works</p>
          <h2>「行けるつもりだった」を、出発前に潰す。</h2>
          <p>
            旅程が崩れる原因は、たいてい予定そのものではなく予定と予定のあいだにあります。
            たびまっぷは、予定のあいだに移動手段と所要時間を自動で挟みます。
            無料プランは直線距離からの概算、Pro なら実際の道のりから計算した値に変わります。
          </p>
        </div>

        <div class="crop">
          <div class="crop-frame" role="img" aria-label="トリップ詳細のタイムラインの一部。先頭に「移動時間は直線距離のおおよその値。Pro で実際の経路から計算できる。」という案内があり、9時から12時の「美ら海水族館」と14時から15時の「古宇利大橋をドライブ」のあいだに、車で約25分の移動が挟まっている。">
            <p class="upsell">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M6 17v-4l1.6-4.2A2 2 0 0 1 9.5 7.5h5a2 2 0 0 1 1.9 1.3L18 13v4"/><circle cx="8" cy="17" r="1.6"/><circle cx="16" cy="17" r="1.6"/></svg>
              移動時間は直線距離のおおよその値。Pro で実際の経路から計算できる。
            </p>

            <div class="tl">
              <div class="tl-item">
                <span class="tl-rail"><b>9:00</b><b>–12:00</b><i></i></span>
                <div class="tl-card">
                  <span class="tl-top">
                    <span class="tl-name">美ら海水族館</span>
                    <span class="tl-bell" aria-hidden="true">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 8-3 8h18s-3-1-3-8z"/><path d="M10.3 21a2 2 0 0 0 3.4 0"/></svg>
                    </span>
                  </span>
                  <span class="tl-spot">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.4A2.4 2.4 0 1 1 12 6.6a2.4 2.4 0 0 1 0 4.8z"/></svg>
                    沖縄美ら海水族館
                  </span>
                  <span class="tl-meta">¥12,000 ・ 1時間前に通知</span>
                </div>
              </div>

              <div class="tl-move focus">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M6 17v-4l1.6-4.2A2 2 0 0 1 9.5 7.5h5a2 2 0 0 1 1.9 1.3L18 13v4"/><circle cx="8" cy="17" r="1.6"/><circle cx="16" cy="17" r="1.6"/></svg>
                車 約25分
              </div>

              <div class="tl-item">
                <span class="tl-rail"><b>14:00</b><b>–15:00</b><i></i></span>
                <div class="tl-card">
                  <span class="tl-top"><span class="tl-name">古宇利大橋をドライブ</span></span>
                  <span class="tl-spot">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.4A2.4 2.4 0 1 1 12 6.6a2.4 2.4 0 0 1 0 4.8z"/></svg>
                    古宇利大橋
                  </span>
                  <span class="tl-meta">¥5,000</span>
                </div>
              </div>
            </div>
          </div>
          <p class="crop-cap">トリップ詳細 → タイムライン（無料プランの表示）</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 機能 ============ -->
  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head rise">
        <p class="eyebrow">Features</p>
        <h2>旅のあいだ、ずっと使えるように。</h2>
        <p>計画中だけでなく、現地でも、帰ったあとでも開けるアプリを目指しています。</p>
      </div>

      <div class="features rise">
        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </span>
          <h3>日別タイムライン</h3>
          <p>日付チップで日を切り替えると、その日の動きがひと目で分かります。タイトル・時刻・場所・メモ・費用を1つの予定にまとめて記録できます。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          </span>
          <h3>カレンダー表示</h3>
          <p>トップの一覧をタイムラインとカレンダーで切り替え。何日目にどこへ行くのかを俯瞰できます。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </span>
          <h3>地図から保存</h3>
          <p>施設をタップ、または地図を長押しした地点をそのまま保存。メモを添えておけば、なぜ行きたかったのかを忘れません。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h9"/><circle cx="19" cy="18" r="2"/></svg>
          </span>
          <h3>自分で作るカテゴリ</h3>
          <p>グルメ・観光・宿泊・ショッピングに加えて、カテゴリの追加と並べ替えができます。保存が増えても迷子になりません。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11"/><path d="m8 10 4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
          </span>
          <h3>Google マップから取り込み</h3>
          <p>これまで貯めてきた保存済みリストは CSV で取り込めます。Google データエクスポート（Takeout）の zip なら、解凍せずそのまま読み込めます。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 8-3 8h18s-3-1-3-8z"/><path d="M10.3 21a2 2 0 0 0 3.4 0"/></svg>
          </span>
          <h3>予定前のリマインダー</h3>
          <p>10分前・30分前・1時間前・1日前から、予定ごとにタイミングを選べます。チェックインの時間も逃しません。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1 .6-8 6 6 0 0 1 11.3 1.6A3.5 3.5 0 0 1 18 18z"/></svg>
          </span>
          <h3>iCloud で同期</h3>
          <p>同じ Apple アカウントの端末で旅の記録が同期されます。機種変更してもデータはそのまま残ります。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
          </span>
          <h3>共有シートから追加</h3>
          <p>他のアプリで見つけた場所を、共有メニューからたびまっぷへ。アプリを行き来せずに保存できます。</p>
        </div>

        <div class="feature">
          <span class="ic" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12a7 7 0 0 1 14 0"/><path d="M3 19h18"/><path d="M12 5V3"/></svg>
          </span>
          <h3>オフラインでも読める</h3>
          <p>保存済みのデータは電波のない場所でも閲覧できます。海外や山あいでも、今日の予定は手元にあります。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 料金 ============ -->
  <section class="section section-cream" id="pricing">
    <div class="wrap">
      <div class="section-head rise">
        <p class="eyebrow">Pricing</p>
        <h2>まずは無料のまま、旅を1つ。</h2>
        <p>旅の作成・場所の保存・地図・通知は無料で使えます。もっと使いたくなったら Pro へ。</p>
      </div>

      <div class="plans rise">
        <div class="plan plan-free">
          <span class="plan-name">無料</span>
          <p class="price"><strong>¥0</strong></p>
          <ul>
            <li><span class="ck">✓</span><span>旅は2つまで作成</span></li>
            <li><span class="ck">✓</span><span>場所の保存は30件まで</span></li>
            <li><span class="ck">✓</span><span>場所の検索は1日20回まで</span></li>
            <li><span class="ck">✓</span><span>移動時間は直線距離からのおおよその値</span></li>
            <li><span class="ck">✓</span><span>通知・iCloud 同期・取り込みはすべて利用可</span></li>
          </ul>
        </div>

        <div class="plan plan-pro">
          <span class="plan-name">たびまっぷ Pro <span class="tag">上限なし</span></span>
          <p class="price"><strong>¥500</strong> / 月　または　<strong>¥3,800</strong> / 年</p>
          <ul>
            <li><span class="ck">✓</span><span>旅を無制限に作成</span></li>
            <li><span class="ck">✓</span><span>場所を無制限に保存</span></li>
            <li><span class="ck">✓</span><span>場所の検索が回数無制限</span></li>
            <li><span class="ck">✓</span><span><strong>移動時間を実際の経路から計算</strong></span></li>
            <li><span class="ck">✓</span><span>無料プランの機能はすべて含みます</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head rise">
        <p class="eyebrow">FAQ</p>
        <h2>よくある質問</h2>
      </div>

      <div class="faq rise">
        <details>
          <summary>アカウント登録は必要ですか？</summary>
          <p class="faq-body">不要です。すべての機能はアカウントなしで使えます。データは端末内とご本人の iCloud にのみ保存されます。</p>
        </details>
        <details>
          <summary>これまで Google マップに保存した場所を持ち込めますか？</summary>
          <p class="faq-body">はい。保存済みリストの CSV を取り込めます。Google データエクスポート（Takeout）で書き出した zip は、解凍せずそのまま読み込めます。</p>
        </details>
        <details>
          <summary>旅の記録は他の端末でも見られますか？</summary>
          <p class="faq-body">同じ Apple アカウントでサインインしている端末どうしで iCloud 同期されます。機種変更してもデータは引き継がれます。</p>
        </details>
        <details>
          <summary>無料プランの上限に達したらどうなりますか？</summary>
          <p class="faq-body">それまでに保存した旅と場所はそのまま閲覧・編集できます。新しく追加するときに Pro のご案内が表示されます。</p>
        </details>
        <details>
          <summary>Pro の解約方法は？</summary>
          <p class="faq-body">端末の「設定」＞ Apple アカウント ＞「サブスクリプション」から、いつでも自動更新を停止できます。アプリ内の「たびまっぷ Pro」画面からも管理できます。</p>
        </details>
        <details>
          <summary>位置情報は何に使われますか？</summary>
          <p class="faq-body">地図に現在地を表示する目的でのみ使用します。旅・予定・保存した場所の内容を開発者が取得することはありません。地図の表示と場所の検索には Google Maps Platform を利用しています。</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ 締め ============ -->

{
  // 完全な静的サイトなので Worker のスクリプトは持たない（"main" を書かない）。
  // Cloudflare は新規プロジェクトに Pages ではなく Workers を勧めている。
  // https://developers.cloudflare.com/workers/static-assets/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabimap-lp",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist/",
    // dist/support/index.html を /support で出す（既定値）
    "html_handling": "auto-trailing-slash",
    // 未知のパスは src/pages/404.astro から生成される 404.html を返す
    "not_found_handling": "404-page"
  }
}
